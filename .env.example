# Engram 配置模板 — 复制为 .env 并填入密钥。
# 完整变量参考（自动生成）：docs/configuration.md
# LLM 密钥：至少填写一个；其他 provider（OpenAI/Qwen/Anthropic/Gemini…）见配置参考。
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Tavily 联网搜索（可选；留空回退 DuckDuckGo）
# TAVILY_API_KEY=

# 权力授予开关（默认关闭；依赖齐备也不会自动开启，需在此显式同意，或运行 engram init）
ENGRAM_MCP_ENABLED=false
ENGRAM_SANDBOX_USE=